# Backend production settings. Keep real values in the deployment secret store.
LIFEOPS_PAYTO=0x0000000000000000000000000000000000000000
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_BASE_URL=https://web3.okx.com
# Use Upstash on hosts without persistent disks. SQLite remains supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LIFEOPS_REPLAY_DB=
LIFEOPS_DEMO_MODE=false
LIFEOPS_PREVIEW_ENABLED=true
LIFEOPS_CORS_ORIGINS=http://localhost:3000
LIFEOPS_RATE_LIMIT_PER_MINUTE=60
LIFEOPS_RESULT_TTL_SECONDS=1800

# Optional strict-schema LLM extraction.
OPENAI_API_KEY=
LIFEOPS_MODEL=gpt-4o-mini
